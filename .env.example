# ============================================================================
# Delivery Batch Analytics on Spark — переменные окружения.
# Скопируй в .env (cp .env.example .env) перед `docker compose up`.
# Порты намеренно отличаются от Project 1, чтобы проекты можно было держать
# рядом (но при 16 ГБ RAM одновременно лучше не запускать оба).
# ============================================================================

# --- ClickHouse (витрины) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=analytics

# --- Airflow ---
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# --- Spark (local-режим внутри Airflow) ---
# Память драйвера Spark. На 16 ГБ RAM комфортно 5g (с запасом под ОС/докер).
SPARK_DRIVER_MEMORY=5g
# Число партиций шафла — ключевой тюнинг; см. benchmark и README.
SPARK_SHUFFLE_PARTITIONS=64
